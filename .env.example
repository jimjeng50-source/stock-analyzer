# FinMind API Token（免費申請：https://finmindtrade.com/）
FINMIND_TOKEN=your_finmind_token_here

# Anthropic Claude API Key（https://console.anthropic.com/）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram 推播目標 Chat ID（向你的 Bot 傳送 /start 後，向 @userinfobot 查詢即可取得）
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === v3 新增設定 ===

# Email 推播設定（使用 Gmail App Password 或其他 SMTP）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL=target_email@gmail.com

# 產業鏈分析追蹤清單（逗號分隔，留空=使用系統預設）
WATCHLIST_SEMICONDUCTOR=2330,2303,2454,3711,5483
WATCHLIST_AI_SERVER=2317,2382,3037,6274
WATCHLIST_EV=6409,1513,2231

# ===== v4 Screener 設定 =====
SCREENER_UNIVERSE_SIZE=200      # 候選池大小（建議初期 200）
SCREENER_TOP_N=5                # 每日推薦數量

# 自訂觀察名單（逗號分隔，這些股票不受流動性篩選限制）
WATCHLIST_CUSTOM=2330,6213,2454

# ===== v6 盤中即時資金流監控 =====

# 盤中監控清單（逗號分隔）。留空 → 退回 WATCHLIST_CUSTOM → 再退回最近 7 日推薦名單
INTRADAY_WATCHLIST=2330,2454,3231
# 觸發 Telegram 推播的最低進場分數（0~100，建議 70）
INTRADAY_MIN_SCORE=70
# 同一檔推播後的冷卻分鐘數（避免洗版）
INTRADAY_COOLDOWN_MIN=30
# 盤中輪詢間隔（秒）；MIS 約 5 秒更新一次，20~30 秒已足夠
INTRADAY_POLL_INTERVAL=30
# 監控清單上限（一次請求的頻道數有限，過多會拖慢輪詢）
INTRADAY_MAX_WATCH=15
